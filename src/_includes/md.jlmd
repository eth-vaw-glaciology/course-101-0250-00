---
layout: "layout.jlhtml"
---

```{=html}
<pluto-editor skip-custom-element class="disable_ui static_preview">
<main>
<preamble></preamble>
<pluto-notebook>
<pluto-cell>
<pluto-output class="pages-markdown rich_output">
<div class="raw-html-wrapper ">
<div class="markdown">
$(content)
</div>
</div>
</pluto-output>
</pluto-cell>
</pluto-notebook>
</main>
</pluto-editor>
$(if get(page.output.frontmatter, "toc", false) == true
    @htl("""
    <link rel="stylesheet" href="$(root_url)/assets/styles/toc.css" type="text/css" />
    <script src="$(root_url)/assets/scripts/toc.js" type="module"></script>
    """)
end)
```
